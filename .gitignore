.DS_Store
# Local Claude Code settings stay out of the repo, but shared maintenance
# agents under .claude/agents/ are versioned.
.claude/*
!.claude/agents/
__pycache__/
*.py[cod]
# Eval run artifacts — never commit. Transcripts and raw outputs can capture
# API tokens, instance URLs, and other secrets surfaced by agent tool calls.
# Re-archive selectively (with redaction) if needed; do not relax this pattern.
evals/workspaces/
evals/results/
evals/eval-env.local.json
evals/.env.local

evals/report.html
