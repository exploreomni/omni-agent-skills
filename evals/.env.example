# Copy to evals/.env.local and fill in local runtime credentials.
# evals/.env.local is gitignored.

# Agent/judge model credentials. Set the one your selected agent/model needs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Required: Omni credentials passed into the BenchFlow sandbox.
OMNI_BASE_URL=
OMNI_API_TOKEN=

# Optional runner defaults.
EVAL_AGENT=claude-agent-acp
EVAL_MODEL=claude-sonnet-4-6
EVAL_SANDBOX=docker
EVAL_CONCURRENCY=1
