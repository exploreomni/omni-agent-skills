#!/usr/bin/env bash

set -euo pipefail

DEFAULT_SOURCE="https://github.com/exploreomni/omni-claude-skills.git"
DEFAULT_REF="main"
DEFAULT_VENDOR_BRANCH="vendor/omni-claude-skills"

usage() {
  cat <<'EOF'
Usage: bin/sync-upstream [--source <path-or-url>] [--ref <git-ref>] [--vendor-branch <branch>]

Rebuilds a filtered vendor branch from omni-claude-skills and merges it into the
currently checked out branch.

Excluded from imported history:
  - .claude-plugin/
  - plugins/omni-analytics/.claude-plugin/
  - README.md

Defaults:
  --source        https://github.com/exploreomni/omni-claude-skills.git
  --ref           main
  --vendor-branch vendor/omni-claude-skills
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

source_repo="$DEFAULT_SOURCE"
source_ref="$DEFAULT_REF"
vendor_branch="$DEFAULT_VENDOR_BRANCH"

while (($#)); do
  case "$1" in
    --source)
      [[ $# -ge 2 ]] || die "--source requires a value"
      source_repo="$2"
      shift 2
      ;;
    --ref)
      [[ $# -ge 2 ]] || die "--ref requires a value"
      source_ref="$2"
      shift 2
      ;;
    --vendor-branch)
      [[ $# -ge 2 ]] || die "--vendor-branch requires a value"
      vendor_branch="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run this inside the target repository"
current_branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD)"

[[ "$current_branch" != "HEAD" ]] || die "check out a branch before syncing"
[[ -z "$(git -C "$repo_root" status --porcelain)" ]] || die "working tree must be clean before syncing"

tmp_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

printf 'Cloning %s at %s\n' "$source_repo" "$source_ref"
clone_cmd=(git clone --branch "$source_ref" --single-branch "$source_repo" "$tmp_dir/upstream")
if [[ -d "$source_repo" ]]; then
  clone_cmd=(git clone --no-local --branch "$source_ref" --single-branch "$source_repo" "$tmp_dir/upstream")
fi
"${clone_cmd[@]}"

printf 'Filtering excluded paths from history\n'
(
  cd "$tmp_dir/upstream"
  FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch -f --prune-empty \
    --index-filter 'git rm -r --cached --ignore-unmatch -- .claude-plugin README.md plugins/omni-analytics/.claude-plugin' \
    -- "$source_ref" >/dev/null
)

printf 'Updating %s\n' "$vendor_branch"
git -C "$repo_root" fetch "$tmp_dir/upstream" \
  "+refs/heads/$source_ref:refs/heads/$vendor_branch" >/dev/null

merge_args=(merge --no-ff --no-edit "$vendor_branch")
if ! git -C "$repo_root" merge-base "$current_branch" "$vendor_branch" >/dev/null 2>&1; then
  merge_args=(merge --allow-unrelated-histories --no-ff --no-edit "$vendor_branch")
fi

printf 'Merging %s into %s\n' "$vendor_branch" "$current_branch"
git -C "$repo_root" "${merge_args[@]}"

printf 'Sync complete\n'
